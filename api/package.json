{
  "name": "socialpulse-engine",
  "version": "2.0.0",
  "description": "Production-ready social media engagement engine with Clean Architecture and DDD",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:core": "NODE_OPTIONS=--experimental-vm-modules jest src/platform/core",
    "test:endpoints": "NODE_OPTIONS=--experimental-vm-modules jest src/__tests__/endpoints --verbose",
    "test:llm": "node --loader ts-node/esm src/scripts/test-llm.ts",
    "test:automation-selectors": "node --loader ts-node/esm src/scripts/test-automation-selectors.ts",
    "generate:engagement-text": "node --loader ts-node/esm src/scripts/generate-engagement-text.ts"
  },
  "keywords": [
    "social-media",
    "automation",
    "clean-architecture",
    "ddd",
    "typescript",
    "express",
    "content-pipeline"
  ],
  "author": "Aniefon Akpan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniefon/socialpulse-engine.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@bull-board/api": "^5.23.0",
    "@bull-board/express": "^5.23.0",
    "@types/bcrypt": "^6.0.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "html-entities": "^2.6.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.6",
    "node-llama-cpp": "^3.14.2",
    "openai": "^6.9.1",
    "playwright": "^1.41.0",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "prom-client": "^15.1.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tesseract.js": "^5.1.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
