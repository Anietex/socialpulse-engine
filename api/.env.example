# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Playwright / Automation
AUTOMATION_NAV_TIMEOUT_MS=20000
AUTOMATION_DRY_RUN=true
AUTOMATION_REPLY_TEXT="Appreciate this perspective—thanks for sharing!"
AUTOMATION_QUOTE_TEXT="Interesting take. Worth a read."
PLAYWRIGHT_STORAGE_PATH=./playwright-storage.json
# PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_COOKIES_PATH=./cookies/x-cookies.json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/socialpulse-engine
MONGODB_TEST_URI=mongodb://localhost:27017/socialpulse-engine-test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Queue Configuration
QUEUE_CLEANUP_CONCURRENCY=5
QUEUE_OCR_CONCURRENCY=3
QUEUE_CATEGORIZATION_CONCURRENCY=5
QUEUE_EVALUATION_CONCURRENCY=5
QUEUE_AUTOMATION_CONCURRENCY=2

# LLM / Model
LLM_MODEL_PATH=./models/qwen3-4b/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_MAX_CONCURRENCY=18

# Engagement LLM (Groq/OpenRouter)
ENGAGEMENT_LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_REFERRER=https://localhost
OPENROUTER_TITLE=socialpulse-engine

# ========================================
# LLM Provider Configuration (OpenAI or Ollama)
# ========================================
# Provider selection: 'openai' or 'ollama'
# If not set, defaults to OpenAI if OPENAI_API_KEY is present, otherwise Ollama
LLM_PROVIDER=ollama

# OpenAI Configuration (Cloud-based)
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=150
LLM_TIMEOUT=30000

# Ollama Configuration (Local LLM)
# Required if LLM_PROVIDER=ollama (or default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=500
OLLAMA_TIMEOUT=60000
